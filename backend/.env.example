# Copy to .env and fill in. Provided by the challenge.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# auto uses OpenAI when OPENAI_API_KEY is present and the local structured
# fallback otherwise. Set explicitly to "openai" or "local" when desired.
EXTRACTOR_MODE=auto
EXTRACTION_MODEL=gpt-5.4-mini
# Uses EXTRACTION_MODEL when omitted. Keeping it separate makes the latency,
# quality, and cost trade-off explicit.
RESPONSE_MODEL=gpt-5.4-mini
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Lower values react faster but are more likely to split a natural pause.
VOICE_VAD_STOP_SECS=0.20
VOICE_TURN_END_SILENCE_SECS=0.20
VOICE_SPECULATION_STABILITY_SECS=0.12

# Leave DATABASE_URL empty for the process-local demo. Set it to make calls,
# offers, usage and bookings durable across workers and restarts.
DATABASE_URL=
# Supabase direct URL for schema migrations. It may be the same as DATABASE_URL
# for local PostgreSQL or a persistent backend using the direct connection.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=10
TURN_CLAIM_SECONDS=120
CLINIC_ID=prosper_demo_clinic

# Structured debugging. JSONL files are written to backend/.logs by default.
APP_ENV=development
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_CONSOLE_JSON=false
LOG_JSON_FILES=true
LOG_DIR=
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
# Patient wording is excluded from operational logs unless explicitly enabled
# for a consented local debugging session. Never enable this in production.
LOG_INCLUDE_TRANSCRIPTS=false
# The local log viewer API is disabled automatically when APP_ENV=production.
ENABLE_DEBUG_LOG_API=true
